{
  "manifest_version": 3,
  "name": "UserTesting Opportunity Notifier",
  "version": "1.0.0",
  "description": "Monitors UserTesting for new test opportunities and notifies you instantly — even when the tab isn't focused.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_badge_text": ""
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "notifications",
    "alarms",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.usertesting.com/*"
  ]
}
